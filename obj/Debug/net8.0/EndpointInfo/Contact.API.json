            "nullable": true
          },
          "partsUsed": {
            "type": "string",
            "nullable": true
          },
          "totalCost": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Sale": {
        "required": [
          "clientId",
          "price",
          "serviceId"
        ],
        "type": "object",
        "properties": {
          "clientId": {
            "type": "integer",
            "format": "int32"
          },
          "serviceId": {
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "type": "number",
