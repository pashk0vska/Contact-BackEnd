  "components": {
    "schemas": {
      "Client": {
        "required": [
          "fullName",
          "phone"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "minLength": 1,
            "type": "string"
          },
          "phone": {
